# Safe production template for the cPanel ZIP package.
# Copy this file to .env on the server, then fill in every deployment-specific value.
# Never commit the populated .env file or put real credentials in this template.

APP_NAME="Rad Art Marketplace"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example

# Keep Laravel's generated optimization caches disabled unless your deployment
# process explicitly manages these cache files.
APP_CONFIG_CACHE=storage/framework/cache-disabled/config.php
APP_ROUTES_CACHE=storage/framework/cache-disabled/routes.php
APP_EVENTS_CACHE=storage/framework/cache-disabled/events.php

APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=your_cpanel_database
DB_USERNAME=your_cpanel_database_user
DB_PASSWORD=replace_with_your_database_password

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
SESSION_SECURE_COOKIE=true

# Configure SMTP values if the application sends email.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
