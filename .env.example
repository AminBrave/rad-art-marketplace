APP_NAME="Rad Art Marketplace"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Local default; set the public HTTPS origin in the deployed .env file.
APP_URL=http://localhost

# Keep Laravel optimization caches disabled in development and production.
# Leave these targets nonexistent; do not run Artisan optimize/cache commands.
APP_CONFIG_CACHE=storage/framework/cache-disabled/config.php
APP_ROUTES_CACHE=storage/framework/cache-disabled/routes.php
APP_EVENTS_CACHE=storage/framework/cache-disabled/events.php
APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rad_art_marketplace
DB_USERNAME=
DB_PASSWORD=

# cPanel-friendly drivers: no Redis or persistent worker required.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=database
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90
BCRYPT_ROUNDS=12

# Configure SMTP credentials in the hosting environment; never commit real secrets.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Set SESSION_SECURE_COOKIE=true when the production site is served over HTTPS.
SESSION_SECURE_COOKIE=false

# Meta Instagram API with Unified Login (server-side only).
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
META_INSTAGRAM_CONFIG_ID=
# Must exactly match the callback URI registered in the Meta configuration.
META_INSTAGRAM_REDIRECT_URI=
META_GRAPH_API_VERSION=v27.0

VITE_APP_NAME="${APP_NAME}"
