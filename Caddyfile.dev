# One HTTPS entry point for the normal development workflow.
# RAD_LAN_HOST is resolved by scripts/project.mjs and must be this machine's private IPv4.
# Laravel and Vite listen on loopback only; Caddy is the only LAN-facing process.
rad.localhost, rad.home.arpa, {$RAD_LAN_HOST} {
    tls internal

    @vite path /@* /resources/* /node_modules/* /__vite_hmr
    handle @vite {
        reverse_proxy 127.0.0.1:5173
    }

    handle {
        reverse_proxy 127.0.0.1:8000
    }
}
