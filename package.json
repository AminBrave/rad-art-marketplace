{
  "name": "rad-art-marketplace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "ai:context": "node scripts/ai-context.mjs",
    "setup": "node scripts/project.mjs setup",
    "dev": "node scripts/project.mjs dev",
    "production": "vite build",
    "db:sqlite:init": "node scripts/project.mjs db:sqlite:init",
    "db:status": "php artisan migrate:status",
    "db:migrate": "php artisan migrate",
    "db:seed": "php artisan db:seed",
    "db:seed:demo": "php artisan db:seed --class=DemoDatabaseSeeder",
    "db:fresh": "php artisan migrate:fresh --seed",
    "test:backend": "node scripts/project.mjs test:backend",
    "test:unit": "node scripts/project.mjs test:unit",
    "test:feature": "node scripts/project.mjs test:feature",
    "test:integration": "node scripts/project.mjs test:integration",
    "test:frontend": "node scripts/project.mjs test:frontend",
    "test:browser": "node scripts/project.mjs test:browser",
    "test:report": "node scripts/project.mjs test:report",
    "test:reporting": "node scripts/project.mjs test:reporting",
    "lint": "eslint resources/js --max-warnings=0",
    "lint:fix": "eslint resources/js --fix",
    "a11y:colors": "node --test tests/js/colorAccessibility.test.js",
    "build:cpanel": "vite build --config vite.config.cpanel.js"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-tabs": "^1.1.4",
    "@tanstack/react-query": "^5.107.1",
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "lucide-react": "^1.71.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "laravel-vite-plugin": "^1.2.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7",
    "eslint-plugin-react": "^7.37.5"
  },
  "engines": {
    "node": ">=20.13.0"
  }
}
