#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

usage() {
  cat <<'USAGE'
Usage: ./scripts/verify <backend|frontend|browser|all>

  backend   Laravel feature tests and PHP style check
  frontend  JavaScript unit tests, ESLint, standard and cPanel production builds
  browser   Playwright browser and full-stack tests (requires a prepared app)
  all       Run every verification layer in sequence

This script does not install dependencies, start services, modify databases,
or invoke GitHub Actions. Prepare the local environment before running it.
USAGE
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || {
    printf 'Missing required command: %s\n' "$1" >&2
    exit 1
  }
}

backend() {
  require_command composer
  composer test
  composer lint
}

frontend() {
  require_command npm
  npm run test:frontend
  npm run lint
  npm run build
  npm run build:cpanel
}

browser() {
  require_command python
  python -m unittest discover -s tests/browser -p 'test_*.py' -v
}

case "${1:-}" in
  backend) backend ;;
  frontend) frontend ;;
  browser) browser ;;
  all) backend; frontend; browser ;;
  -h|--help|"") usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac
